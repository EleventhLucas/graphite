{
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun", "vite/client", "vitest/globals"]
  },
  "include": ["src", "tools", "electrobun.config.ts", "hutch.config.ts", "vite.config.ts"]
}
