{
  "name": "graphite",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, offline Markdown editor for Obsidian vaults.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:renderer": "electrobun prepare && vite build",
    "dev": "bun run build:renderer && electrobun dev --watch",
    "dev:renderer": "bun run dev:web",
    "dev:web": "vite --mode web --port 5173",
    "build:web": "vite build --mode web",
    "build": "bun tools/prepare-icons.ts && bun run build:renderer && electrobun build --env=stable",
    "package:windows": "bun tools/package-windows.ts && bun run build",
    "package:appimage": "bun tools/package-appimage.ts",
    "sandbox:embed-assets": "bun tools/embed-sandbox-assets.ts",
    "sandbox:reset": "bun tools/create-sandbox-vault.ts --reset",
    "test": "vitest run",
    "test:smoke": "vitest run src/smoke",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/ia-writer-quattro": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@uiw/react-codemirror": "^4.25.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "^5.4.54",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "1.4.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "electrobun": "2.0.1",
    "jsdom": "^26.1.0",
    "png-to-ico": "^3.0.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^3.2.4"
  }
}
